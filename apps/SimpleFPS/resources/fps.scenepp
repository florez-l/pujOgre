<?xml version="1.0" encoding="UTF-8"?>
<scene formatVersion="1.1">

  <userData>
    <property name="gravity" type="vector" data="0 -9.81 0"/>
  </userData>

  <environment>
    <colourAmbient r="0.9" g="0.9" b="0.9"/>
  </environment>

  <nodes>
    <node name="Player" >
      <position x="0" y="0" z="1.7" />
      <rotation qw="1" qx="0" qy="0" qz="0" />
      <scale x="1" y="1" z="1" />
      <camera fov="0.503380" name="Player" projectionType="perspective" >
        <clipping far="10000" near="0.01" />
      </camera>
    </node>

    <node name="Ground">
      <plane
          name="GroundPlane" distance="0" width="20" height="20"
          xSegments="20" ySegments="20" numTexCoordSets="1"
          uTile="4" vTile="4" hasNormals="true" material="Ground"
          >
        <normal x="0" y="1" z="0"/>
        <upVector x="0" y="0" z="-1"/>
      </plane>
      <userData>
        <property name="mass" type="float" data="0"/>
      </userData>
    </node>

    <node name="Ceiling">
      <position x="0" y="5" z="0"/>
      <plane
          name="CeilingPlane" distance="0" width="20" height="20"
          xSegments="20" ySegments="20" numTexCoordSets="1"
          uTile="4" vTile="4" hasNormals="true" material="Ceiling"
          >
        <normal x="0" y="-1" z="0"/>
        <upVector x="0" y="0" z="1"/>
      </plane>
      <userData>
        <property name="mass" type="float" data="0"/>
      </userData>

<?xml version="1.0" encoding="UTF-8"?>
<scene formatVersion="1.1">
  <parametricSurfaces>
      <parametricSurface name="Torus" material="RedTorus" uResolution="96" vResolution="48">
        <uRange min="0" max="6.283185307" join="true"/>
        <vRange min="0" max="6.283185307" join="true"/>
        <param name="R" value="2"/>
        <param name="r" value="0.6"/>
        <point  x="(R + r*cos(v))*cos(u)" y="(R + r*cos(v))*sin(u)" z="r*sin(v)"/>
        <normal x="cos(v)*cos(u)"         y="cos(v)*sin(u)"         z="sin(v)"/>
      </parametricSurface>
  </parametricSurfaces>

  <nodes>
    <node name="Left">
      <position x="-3" y="0" z="0"/>
      <parametricSurface ref="Torus" name="TorusLeft"/>
    </node>
    <node name="Middle">
      <parametricSurface ref="Torus" material="KleinTextured"/>
    </node>
    <node name="Right">
      <scale x="0.6" y="0.6" z="0.6"/>
      <parametricSurface ref="Torus"/>
    </node>
    <node name="LightNode">
      <position x="4" y="6" z="8"/>
      <light name="MainLight" type="point">
        <colourDiffuse  r="1" g="1" b="1"/>
        <colourSpecular r="1" g="1" b="1"/>
      </light>
    </node>
    <node name="MainCamera" >
      <position x="0" y="0" z="8" />
      <rotation qw="0.002405" qx="-0.004120" qy="0.983850" qz="0.178934" />
      <scale x="1.000000" y="1.000000" z="1.000000" />
      <camera fov="0.503380" name="MainCamera" projectionType="perspective" >
        <clipping far="10000.000000" near="0.100000" />
      </camera>
    </node>
  </nodes>
</scene>


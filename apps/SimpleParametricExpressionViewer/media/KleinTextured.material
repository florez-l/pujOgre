// Textured material for the Klein bottle.
// A Klein bottle has only one side, so both triangle faces must be drawn.
material KleinTextured
{
    technique
    {
        pass
        {
            cull_hardware none

            ambient  0.7 0.7 0.7
            diffuse  1 1 1
            specular 0.35 0.35 0.35 32

            texture_unit
            {
                texture klein_checker.png
                tex_address_mode wrap
                filtering anisotropic
                max_anisotropy 8
            }
        }
    }
}

# plugins.cfg for TorusApp -- generated by CMake. Edit plugins.cfg.in (or the
# APP_PLUGINS / APP_EXTRA_PLUGINS CMake variables) instead of this file.

# Folder for the Plugin= entries below (no extension needed: .so/.dll is added by Ogre)
PluginFolder=@OGRE_PLUGIN_DIR@

@APP_PLUGIN_LINES@
# Plugins that live outside PluginFolder, given by full path.
# Ogre ignores this key; TorusApp reads it and loads these itself.
@APP_EXTRA_PLUGIN_LINES@

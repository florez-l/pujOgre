<?xml version="1.0" encoding="UTF-8"?>
<scene formatVersion="1.1">

  <userData>
    <property name="gravity" type="vector" data="0 -9.81 0"/>
  </userData>

  <environment>
    <colourAmbient r="0.3" g="0.3" b="0.3"/>
  </environment>

    <parametricSurfaces>
      <parametricSurface name="Sphere" uResolution="16" vResolution="16">
        <uRange min="0" max="3.141592653" join="true"/>
        <vRange min="0" max="6.283185307" join="true"/>
        <param name="R" value="1"/>
        <point  x="R*sin(u)*cos(v)" y="R*sin(u)*sin(v)" z="R*cos(u)"/>
        <normal x="sin(u)*cos(v)"   y="sin(u)*sin(v)"   z="cos(u)"/>
      </parametricSurface>
  </parametricSurfaces>

  <nodes>
    <node name="GroundNode">
      <plane
          name="Ground" distance="0" width="20" height="20"
          xSegments="20" ySegments="20" numTexCoordSets="1"
          uTile="4" vTile="4" hasNormals="true" material="KleinTextured"
          >
        <normal   x="0" y="1" z="0"/>
        <upVector x="0" y="0" z="-1"/>
      </plane>
      <userData>
        <property name="mass" type="float" data="0"/>
      </userData>
    </node>

    <node name="ball_1">
      <position x="0" y="10" z="0"/>
      <parametricSurface ref="Sphere" material="KleinTextured">
        <param name="R" value="0.4"/>
      </parametricSurface>
      <userData>
        <property name="collider" type="string" data="sphere"/>
        <property name="mass" type="float" data="1"/>
        <property name="restitution" type="float" data="0.8"/>
        <property name="friction" type="float" data="0.6"/>
        <property name="rolling_friction" type="float" data="0.01"/>
        <property name="spinning_friction" type="float" data="0.1"/>
        <property name="linear_damping" type="float" data="0.05"/>
        <property name="angular_damping" type="float" data="0.1"/>
      </userData>
    </node>
    
    <node name="ball_2">
      <position x="1" y="15" z="0"/>
      <parametricSurface ref="Sphere" material="KleinTextured">
        <param name="R" value="1"/>
      </parametricSurface>
      <userData>
        <property name="collider" type="string" data="sphere"/>
        <property name="mass" type="float" data="10"/>
        <property name="restitution" type="float" data="1"/>
        <property name="friction" type="float" data="0.8"/>
        <property name="rolling_friction" type="float" data="0.1"/>
        <property name="spinning_friction" type="float" data="0.1"/>
        <property name="linear_damping" type="float" data="0.5"/>
        <property name="angular_damping" type="float" data="0.001"/>
      </userData>
    </node>

    <node name="LightNode">
      <position x="5" y="10" z="5"/>
      <light name="MainLight" type="point">
        <colourDiffuse  r="1" g="1" b="1"/>
        <colourSpecular r="0.5" g="0.5" b="0.5"/>
      </light>
    </node>

  </nodes>
</scene>

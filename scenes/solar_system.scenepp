<?xml version="1.0" encoding="UTF-8"?>
<scene formatVersion="1.1">

  <parametricSurfaces>
      <parametricSurface name="Sphere" uResolution="16" vResolution="16">
        <uRange min="0" max="3.141592653" join="true"/>
        <vRange min="0" max="6.283185307" join="true"/>
        <param name="R" value="1"/>
        <point  x="R*sin(u)*cos(v)" y="R*sin(u)*sin(v)" z="R*cos(u)"/>
        <normal x="sin(u)*cos(v)"   y="sin(u)*sin(v)"   z="cos(u)"/>
      </parametricSurface>
  </parametricSurfaces>

  <nodes>
    <node name="Sun">
      <node name="SunSpin">
        <userData>
          <property name="spinPeriod" type="float" data="2000"/>
        </userData>
        <parametricSurface ref="Sphere" material="KleinTextured">
          <param name="R" value="10"/>
        </parametricSurface>
      </node>

      <node name="Earth">
        <userData>
          <property name="orbitRadius"      type="float" data="20"/>
          <property name="orbitPeriod"      type="float" data="365.25"/>
          <property name="orbitPhase"       type="float" data="0"/>
          <property name="orbitInclination" type="float" data="0"/>
        </userData>
        <node name="EarthSpin">
          <userData>
            <property name="spinPeriod" type="float" data="1"/>
            <property name="axialTilt"  type="float" data="23.4"/>
          </userData>
          <parametricSurface ref="Sphere" material="KleinTextured">
            <param name="R" value="1"/>
          </parametricSurface>
        </node>

        <node name="Moon">
          <userData>
            <property name="orbitRadius" type="float" data="3"/>
            <property name="orbitPeriod" type="float" data="27.3"/>
            <property name="orbitInclination" type="float" data="5.1"/>
          </userData>
          <node name="MoonSpin">
            <userData>
              <property name="spinPeriod" type="float" data="27.3"/>
            </userData>
            <parametricSurface ref="Sphere" material="KleinTextured">
              <param name="R" value="0.1"/>
            </parametricSurface>
          </node>
        </node>
      </node>
    </node>
  </nodes>
</scene>
